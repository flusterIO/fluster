{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "log:allow-log",
        "log:default",
        "dialog:allow-open",
        "dialog:allow-save",
        "opener:allow-open-url",
        "opener:allow-reveal-item-in-dir",
        {
            "identifier": "opener:allow-open-path",
            "allow": [
                {
                    "path": "*"
                }
            ]
        }
    ]
}
