{
    "productName": "Fluster",
    "version": "0.0.2",
    "identifier": "com.fluster.app",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "trayIcon": {
            "iconPath": "icons/Square310x310Logo.png"
        },
        "windows": [
            {
                "title": "Fluster",
                "titleBarStyle": "Overlay",
                "width": 800,
                "height": 600
            }
        ],
        "security": {
            "csp": null,
            "capabilities": [
                {
                    "identifier": "draggable-window",
                    "windows": [
                        "*"
                    ],
                    "permissions": [
                        "core:default",
                        "core:window:allow-start-dragging",
                        "log:allow-log",
                        "log:default",
                        "dialog:allow-open",
                        "dialog:allow-save"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Education",
        "createUpdaterArtifacts": false,
        "shortDescription": "Free & open source academic note taking.",
        "publisher": "Fluster",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "../public/**/*"
        ],
        "macOS": {
            "signingIdentity": "-"
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RkYxRjI2NTI1NkNBODkKUldTSnlsWlNKaC8vOWFna3FUZVYzdVFUYXk1MDhuRXhrMVJiOG91VlkzVTVtSTQ5Mks2RFZMUTgK",
            "dangerousInsecureTransportProtocol": true
        }
    }
}
