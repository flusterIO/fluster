    {
      "type": "github",
      "url": "https://github.com/flusterIO/fluster"
    }
  ],
  "author": "Andrew Mueller <fluster.eyeoh@gmail.com>",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "wireit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p ./tsconfig.json"
  },
  "wireit": {
    "build": {
      "clean": false,
      "command": "tsc && vite build",
      "output": [
        "dist/index.cjs",
        "dist/index.mjs",
        "dist/index.d.ts"
      ]
    }
  },
  "main": "index.js",
  "dependencies": {
    "@datalayer/jupyter-react": "^1.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@fluster.io/config": "workspace:*",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser": "^3.1.4",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^9.0.4",
    "globals": "^16.0.0",
    "jsdom": "26.1.0",
    "sass": "^1.89.0",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "wireit": "0.14.12"
  },
  "license": "ISC",
  "description": ""
}
